<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fisk</groupId>
    <artifactId>swim</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>swim-treesitter</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.fisk</groupId>
      <artifactId>swim-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.fisk</groupId>
      <artifactId>swim-launcher</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.googlecode.lanterna</groupId>
      <artifactId>lanterna</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-c/src</directory>
        <includes><include>grammar.json</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/c</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-c/queries</directory>
        <includes><include>highlights.scm</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/c/queries</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-cpp/src</directory>
        <includes><include>grammar.json</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/cpp</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-cpp/queries</directory>
        <includes><include>highlights.scm</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/cpp/queries</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-java/src</directory>
        <includes><include>grammar.json</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/java</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-java/queries</directory>
        <includes><include>highlights.scm</include></includes>
        <targetPath>org/fisk/swim/treesitter/grammars/java/queries</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-cpp/src</directory>
        <includes><include>parser.c</include></includes>
        <targetPath>org/fisk/swim/treesitter/parsers/cpp</targetPath>
      </resource>
      <resource>
        <directory>${project.parent.basedir}/third_party/tree-sitter-java/src</directory>
        <includes><include>parser.c</include></includes>
        <targetPath>org/fisk/swim/treesitter/parsers/java</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.fisk.swim.treesitter</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-treesitter-jar-to-plugins</id>
            <phase>package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.parent.basedir}/plugins</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}</directory>
                  <includes><include>${project.build.finalName}.jar</include></includes>
                </resource>
              </resources>
              <overwrite>true</overwrite>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
